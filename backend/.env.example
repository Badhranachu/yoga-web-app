# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=yoga_studio
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# Defaults to console backend (reset links print to the runserver log).
# Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend for real delivery,
# e.g. Gmail SMTP with an App Password:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your-address@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
#
# IMPORTANT (deliverability): DEFAULT_FROM_EMAIL/SERVER_EMAIL MUST be the same
# address as EMAIL_HOST_USER when sending through Gmail SMTP. Gmail's relay
# only has SPF/DKIM authorization for its own domain — if From is a different
# domain (e.g. a custom domain you haven't set up SPF/DKIM/DMARC for), that
# authentication fails and the message is very likely to land in spam, or
# Gmail may silently rewrite the From header to the authenticated address
# anyway. Until you set up SPF/DKIM for a custom sending domain, keep these
# three values identical to your Gmail address.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=your-address@gmail.com
SERVER_EMAIL=your-address@gmail.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
