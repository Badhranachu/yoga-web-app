# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=yoga_studio
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# Defaults to console backend (reset links print to the runserver log).
# Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend for real delivery,
# e.g. Gmail SMTP with an App Password:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your-address@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@ekamyoga.ae
SERVER_EMAIL=no-reply@ekamyoga.ae
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
